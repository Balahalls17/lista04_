#include <stdio.h>

int main() {
    int vetor[10];
    int maior, posMaior = 0;
    
    printf("Digite 10 numeros inteiros:\n");
    for (int i = 0; i < 10; i++) {
        printf("Posicao %d: ", i);
        scanf("%d", &vetor[i]);
    }
    
    maior = vetor[0];
    
    for (int i = 1; i < 10; i++) {
        if (vetor[i] > maior) {
            maior = vetor[i];
            posMaior = i;
        }
    }
    
    printf("\nVetor: ");
    for (int i = 0; i < 10; i++) {
        printf("%d ", vetor[i]);
    }
    
    printf("\nMaior elemento: %d\n", maior);
    printf("Posicao do maior elemento: %d\n", posMaior);
    
    return 0;
}
