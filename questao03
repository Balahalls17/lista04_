#include <stdio.h>

int main() {
    float A[10], B[10];
    
    printf("Digite 10 numeros reais:\n");
    for (int i = 0; i < 10; i++) {
        printf("Elemento %d: ", i + 1);
        scanf("%f", &A[i]);
        B[i] = A[i] * A[i]; // Calcula o quadrado
    }
    
    printf("\nVetor original:\n");
    for (int i = 0; i < 10; i++) {
        printf("%.2f ", A[i]);
    }
    
    printf("\nVetor dos quadrados:\n");
    for (int i = 0; i < 10; i++) {
        printf("%.2f ", B[i]);
    }
    printf("\n");
    
    return 0;
}
