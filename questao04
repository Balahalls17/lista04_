#include <stdio.h>

int main() {
    int vetor[8];
    int X, Y;
    
    printf("Digite 8 numeros inteiros:\n");
    for (int i = 0; i < 8; i++) {
        printf("Posicao %d: ", i);
        scanf("%d", &vetor[i]);
    }
    
    printf("\nDigite uma posicao X (0 a 7): ");
    scanf("%d", &X);
    printf("Digite uma posicao Y (0 a 7): ");
    scanf("%d", &Y);
    
    if (X >= 0 && X < 8 && Y >= 0 && Y < 8) {
        int soma = vetor[X] + vetor[Y];
        printf("A soma dos valores nas posicoes %d e %d e: %d\n", X, Y, soma);
    } else {
        printf("Posicoes invalidas!\n");
    }
    
    return 0;
}
