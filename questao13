#include <stdio.h>

int main() {
    float vetor[5];
    int posMaior = 0, posMenor = 0;
    
    printf("Digite 5 valores:\n");
    for (int i = 0; i < 5; i++) {
        printf("Posicao %d: ", i);
        scanf("%f", &vetor[i]);
    }
    
    for (int i = 1; i < 5; i++) {
        if (vetor[i] > vetor[posMaior]) posMaior = i;
        if (vetor[i] < vetor[posMenor]) posMenor = i;
    }
    
    printf("\nPosicao do MAIOR valor (%.2f): Posicao %d\n", vetor[posMaior], posMaior);
    printf("Posicao do MENOR valor (%.2f): Posicao %d\n", vetor[posMenor], posMenor);
    
    return 0;
}
